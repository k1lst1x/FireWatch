# Copy to .env and replace only the placeholder values. Never commit .env.
# Every integration key is optional: missing keys fall back cleanly.
# Run `uv run python scripts/check_setup.py` to see what's live.

SECRET_KEY=replace-with-a-unique-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REQUIRED=true
ADMIN_EMAILS=operator@example.com
MAX_IMAGE_BYTES=8388608
DATABASE_URL=sqlite+aiosqlite:///./firewatch.db
CORS_ORIGINS=http://localhost:5173

# NASA FIRMS: paste your personal MAP_KEY here.
NASA_FIRMS_MAP_KEY=paste-your-map-key-here
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_DAY_RANGE=1

# LLM: set ANTHROPIC_API_KEY (Claude) or OPENAI_API_KEY. If both are set, Claude wins unless LLM_PROVIDER=openai.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OpenAI-compatible provider (e.g. Nebius AI Studio). Leave empty for OpenAI.
OPENAI_BASE_URL=

# Weather: OpenWeatherMap if set, otherwise keyless Open-Meteo.
OPENWEATHERMAP_API_KEY=
WEATHER_FALLBACK_OPEN_METEO=true

# Cameras: AlertWest public API, no key. Nearest online camera within ALERTWEST_MAX_KM of the event.
CAMERA_SOURCE=alertwest
ALERTWEST_MAX_KM=60
ALERTCA_API_KEY=

YOLO_MODEL_PATH=models/fire_yolov8n.pt

REQUIRE_HUMAN_APPROVAL=true
DASHBOARD_WEBHOOK_URL=

# off | record | replay: record real stage-1 data once, replay it on stage if Wi-Fi dies
REPLAY_MODE=off
REPLAY_DIR=replay

FEDERATED_FUSION=true
IS_MOCK=false
