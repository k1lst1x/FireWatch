# Copy to .env and replace only the placeholder values. Never commit .env.
# Every integration key is optional: missing keys fall back cleanly.
# Run `uv run python scripts/check_setup.py` to see what's live.

SECRET_KEY=replace-with-a-unique-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Authentication is required by default.
AUTH_REQUIRED=true
# Administrators are promoted only through backend/scripts/promote_admin.py.
MAX_IMAGE_BYTES=8388608
MAX_ANALYSIS_REQUEST_BYTES=17825792
MAX_IMAGE_PIXELS=16000000
ALLOWED_IMAGE_HOSTS=img.cdn.prod.alertwest.com,www.alertcalifornia.org,cameras.alertcalifornia.org
LOGIN_RATE_LIMIT_PER_MINUTE=5
ANALYSIS_RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_ANALYSES=2
DATABASE_URL=sqlite+aiosqlite:///./firewatch.db
CORS_ORIGINS=http://localhost:5173

# NASA FIRMS: paste your personal MAP_KEY here.
NASA_FIRMS_MAP_KEY=paste-your-map-key-here
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_DAY_RANGE=1

# LLM: set ANTHROPIC_API_KEY (Claude), OPENAI_API_KEY, or NEBIUS_API_KEY.
# If several keys exist, select one explicitly with LLM_PROVIDER=anthropic|openai|nebius.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional custom OpenAI-compatible endpoint. Leave empty for OpenAI.
OPENAI_BASE_URL=
# Nebius AI Studio: after adding the key, run `uv run python scripts/check_nebius.py`
# to list models enabled for your project, then copy one model ID into NEBIUS_MODEL.
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
# Flower Model / Endeavor. This is distinct from the local Flower FL simulation.
FLOWER_API_KEY=
FLOWER_MODEL=flwrlabs/endeavor-1.0
FLOWER_BASE_URL=https://api.flower.ai/v1
# Advisory multi-agent review: experts assess the same evidence independently.
# The Flower Model key above powers an expert; the local Flower FL loop learns only from dispatcher feedback.
MULTI_AGENT_DELIBERATION=true
MULTI_AGENT_EXPERTS=anthropic,nebius,flower

# Weather: OpenWeatherMap if set, otherwise keyless Open-Meteo.
OPENWEATHERMAP_API_KEY=
WEATHER_FALLBACK_OPEN_METEO=true

# Cameras: AlertWest public API, no key. Nearest online camera within ALERTWEST_MAX_KM of the event.
CAMERA_SOURCE=alertwest
ALERTWEST_MAX_KM=60
ALERTCA_API_KEY=

YOLO_MODEL_PATH=models/fire_yolov8n.pt

REQUIRE_HUMAN_APPROVAL=true
DASHBOARD_WEBHOOK_URL=

# off | record | replay: record real stage-1 data once, replay it on stage if Wi-Fi dies
REPLAY_MODE=off
REPLAY_DIR=replay

FEDERATED_FUSION=true
IS_MOCK=false

# Optional. The map works without this using key-free Esri/OSM tiles.
# Set it only if you have a Carto account and want Carto Dark Matter basemaps.
VITE_CARTO_API_KEY=
