# Local development: leave empty to use Vite's /api proxy.
# Static deployment: set this to the public FastAPI origin, without a trailing slash.
# VITE_API_BASE_URL=https://api.example.com

# These are set by the GitHub Pages workflow. Do not set them for local development.
# VITE_BASE_PATH=/FireWatch/
# VITE_ROUTER_MODE=hash
